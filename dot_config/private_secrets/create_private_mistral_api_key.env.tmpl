# ~/.config/secrets/mistral_api_key.env
#
# Created by chezmoi if missing.
#
# Replace the placeholder below with your real Mistral API key after:
#
#   chezmoi apply
#
# This file is intentionally local machine state. Because the chezmoi source
# file uses the create_ attribute, future `chezmoi apply` runs will not
# overwrite your real token once you edit this target file.
#
# Raw key only, no quotes inside, no "Bearer ".

export MISTRAL_API_KEY='mstrl_REPLACE_WITH_YOUR_MISTRAL_KEY'